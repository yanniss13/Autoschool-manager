model ScheduleSlot {
  id       Int      @id @default(autoincrement())
  title    String
  startsAt DateTime
  endsAt   DateTime
  note     String?

  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // Eleve rattache au creneau. Colonne nullable (compat. des creneaux existants) mais
  // exigee par le validateur a la creation/edition. onDelete: Cascade -> supprimer un
  // eleve supprime ses lecons.
  studentId Int?
  student   Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, startsAt])
  @@index([employeeId, startsAt])
  @@index([studentId, startsAt])
}
