{% extends 'layouts/base.twig' %}

{% block content %}
  <section class="page-header">
    <div>
      <p class="eyebrow">Espace élève</p>
      <h1>Assistant code</h1>
      <p class="muted">Pose une question sur le code de la route : priorités, panneaux, vitesse, stationnement, sécurité, alcool...</p>
    </div>
  </section>

  <article class="form-card">
    <div class="assistant-header">
      <h2>Conversation</h2>
      <span class="badge {% if assistantOnline %}badge-available{% else %}badge-muted{% endif %}">
        {% if assistantOnline %}IA en ligne{% else %}Mode local{% endif %}
      </span>
    </div>

    <div class="assistant-thread" data-assistant-thread {% if assistantThread|length == 0 %}hidden{% endif %}>
      {% for entry in assistantThread %}
        <div class="assistant-bubble assistant-bubble--{{ entry.role }}">
          <span class="assistant-bubble__author">{% if entry.role == 'user' %}Toi{% else %}Assistant{% endif %}</span>
          <p>{{ entry.content }}</p>
        </div>
      {% endfor %}
    </div>

    <form action="/student-space/assistant" method="post" id="assistant-form">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <div class="form-group">
        <label for="message">Ta question</label>
        <textarea id="message" name="message" rows="3" maxlength="500" required placeholder="Ex : Que faire à un cédez-le-passage ?"></textarea>
      </div>
      <div class="assistant-actions">
        <button type="submit" class="btn btn-primary" data-assistant-submit>Demander à l'assistant</button>
      </div>
    </form>

    <form action="/student-space/assistant/clear" method="post" class="assistant-clear" id="assistant-clear-form" {% if assistantThread|length == 0 %}hidden{% endif %}>
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <button type="submit" class="btn">Effacer la conversation</button>
    </form>
  </article>
{% endblock %}

{% block scripts %}
  <script src="/js/student-assistant.js" defer></script>
{% endblock %}
