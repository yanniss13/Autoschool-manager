{% extends 'layouts/base.twig' %}

{% block content %}
  <section class="form-card">
    <h1>{% if forced %}Définissez votre mot de passe{% else %}Changer mon mot de passe{% endif %}</h1>

    {% if forced %}
      <div class="flash flash-error">
        Pour votre sécurité, choisissez un nouveau mot de passe avant d'accéder à votre espace.
      </div>
    {% endif %}
    {% if errors.global %}<div class="flash flash-error">{{ errors.global }}</div>{% endif %}

    <form action="/student-space/password" method="post" novalidate>
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">

      <div class="form-group">
        <label for="password">Nouveau mot de passe</label>
        <input type="password" id="password" name="password"
               minlength="8" maxlength="72" autocomplete="new-password" required>
        {% if errors.password %}<p class="field-error">{{ errors.password }}</p>{% endif %}
      </div>

      <div class="form-group">
        <label for="passwordConfirm">Confirmer le mot de passe</label>
        <input type="password" id="passwordConfirm" name="passwordConfirm"
               autocomplete="new-password" required>
        {% if errors.passwordConfirm %}<p class="field-error">{{ errors.passwordConfirm }}</p>{% endif %}
      </div>

      <button type="submit" class="btn btn-primary">Enregistrer</button>
    </form>
  </section>
{% endblock %}
