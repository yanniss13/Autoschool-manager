{% extends 'layouts/base.twig' %}

{% block content %}
  <section class="page-header student-portal-header">
    <div>
      <p class="eyebrow">Espace élève</p>
      <h1>Bonjour {{ student.firstName }}</h1>
      <p class="muted">{{ student.company.businessName }} - Code de la route et leçons de conduite</p>
    </div>
  </section>

  <section class="summary-grid">
    <article class="summary-card">
      <h2>Profil</h2>
      <p><strong>{{ student.firstName }} {{ student.lastName }}</strong></p>
      <p class="muted">{{ student.email }}</p>
      <p><a href="/student-space/password">Changer mon mot de passe</a></p>
    </article>

    <article class="summary-card learning-score-card">
      <h2>Progression code</h2>
      <p class="stat-value">{{ progress.successRate }}%</p>
      <p class="muted">{{ progress.totalScore }}/{{ progress.totalQuestions }} bonnes réponses</p>
      <p class="muted">{{ progress.sessionCount }} session(s) &middot; série de {{ progress.streak }} jour(s)</p>
      <p><a href="/student-space/training" class="btn btn-primary">S'entraîner au code</a></p>
    </article>

    <article class="summary-card">
      <h2>Dernières sessions</h2>
      {% if progress.recent|length > 0 %}
        <ul class="compact-list">
          {% for session in progress.recent %}
            <li>{{ session.theme }} : {{ session.score }}/{{ session.total }}</li>
          {% endfor %}
        </ul>
      {% else %}
        <p class="muted">Aucune session pour le moment.</p>
      {% endif %}
    </article>
  </section>

  <section class="page-header">
    <h2>Mon planning</h2>
  </section>

  <div id="calendar"
       data-events-url="/student-space/events"
       data-editable="false"></div>
{% endblock %}

{% block scripts %}
  {# FullCalendar est charge paresseusement par planning-calendar.js (a l'approche
     du calendrier), pour ne pas executer ~282 Ko de JS au chargement initial. #}
  <script src="/js/planning-calendar.js" defer></script>
{% endblock %}
