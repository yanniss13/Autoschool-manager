{% extends 'layouts/base.twig' %}

{% block content %}
  <section class="page-header">
    <div>
      <p class="eyebrow">Espace élève</p>
      <h1>Entraînement code</h1>
      <p class="muted">Réponds question par question : valide, découvre la correction, puis passe à la suivante.</p>
    </div>
  </section>

  <article class="form-card">
    {# Selecteur de theme : en JS, recharge les questions en AJAX (cf. training-quiz.js).
       Sans JS, ce formulaire GET recharge la page sur le theme choisi (repli). #}
    <form action="/student-space/training" method="get" class="quiz-theme-form" id="quiz-theme-form">
      <div class="form-group">
        <label for="theme">Thème</label>
        <select id="theme" name="theme">
          {% for theme in themes %}
            <option value="{{ theme.id }}" {% if theme.id == selectedTheme.id %}selected{% endif %}>{{ theme.label }}</option>
          {% endfor %}
        </select>
      </div>
      {# Bouton de repli uniquement sans JS : avec JS, le changement se fait en AJAX. #}
      <noscript><button type="submit" class="btn">Changer de thème</button></noscript>
    </form>

    <form action="/student-space/training" method="post" id="training-quiz" data-questions-url="/student-space/training/questions">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">

      <div data-quiz-body>
        {% include 'student-space/_training-quiz.twig' %}
      </div>

      {# Repli sans JavaScript : bouton d'enregistrement direct. #}
      <noscript><button type="submit" class="btn btn-primary">Enregistrer la session</button></noscript>
    </form>
  </article>

  {% if progressChart %}
    <section class="chart-card">
      <header class="chart-card__head">
        <div>
          <h2>Évolution de tes scores</h2>
          <p class="muted">Taux de réussite, de la plus ancienne session à la plus récente.</p>
        </div>
        <div class="chart-card__stats">
          <span class="chart-pill"><strong>{{ progressChart.last.rate }}%</strong> dernière</span>
          <span class="chart-pill chart-pill--soft"><strong>{{ progressChart.average }}%</strong> moyenne</span>
        </div>
      </header>

      <div class="progress-chart-shell">
        <div class="progress-chart"
             data-progress-chart
             data-rates="{{ progressChart.rates|join(',') }}"
             aria-label="Courbe d'évolution des taux de réussite par session"></div>
      </div>

      <noscript>
        <ol class="chart-fallback">
          {% for point in progressChart.points %}
            <li>Session {{ point.index }} : {{ point.rate }}%</li>
          {% endfor %}
        </ol>
      </noscript>
    </section>
  {% endif %}

  {% if missedQuestions|length > 0 %}
    <section class="page-header">
      <h2>Questions à revoir</h2>
      <p class="muted">Les questions ratées lors de tes dernières sessions, avec la bonne réponse.</p>
    </section>

    <div class="review-list">
      {% for question in missedQuestions %}
        <article class="review-card">
          <p class="review-card__q">{{ question.text }}</p>
          {% for choice in question.choices %}
            {% if choice.id == question.correctChoice %}
              <p class="review-card__answer"><span class="review-card__check" aria-hidden="true"></span>{{ choice.text }}</p>
            {% endif %}
          {% endfor %}
          <p class="review-card__why">{{ question.explanation }}</p>
        </article>
      {% endfor %}
    </div>
  {% endif %}

  <section class="page-header">
    <h2>Progression par thème</h2>
  </section>

  <section class="theme-stats-grid">
    {% for theme in progress.themeStats %}
      <article class="theme-stat" style="--rate: {{ theme.rate }}">
        <div class="theme-stat__gauge" role="img" aria-label="{{ theme.rate }} pour cent">
          <span class="theme-stat__gauge-value">{{ theme.rate }}<small>%</small></span>
        </div>
        <div class="theme-stat__meta">
          <h3>{{ theme.label }}</h3>
          <p class="muted">{{ theme.score }}/{{ theme.total }} bonnes réponses</p>
        </div>
      </article>
    {% endfor %}
  </section>
{% endblock %}

{% block scripts %}
  <script src="/vendor/apexcharts/apexcharts.min.js" defer></script>
  <script src="/js/student-progress-chart.js" defer></script>
  <script src="/js/training-quiz.js" defer></script>
{% endblock %}
