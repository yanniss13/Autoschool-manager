{# Champs partages entre les formulaires de creation et d'edition d'un eleve. #}
<input type="hidden" name="_csrf" value="{{ csrfToken }}">

<div class="form-group">
  <label for="lastName">Nom</label>
  <input type="text" id="lastName" name="lastName" value="{{ values.lastName|default('') }}" maxlength="100" required>
  {% if errors.lastName %}<p class="field-error">{{ errors.lastName }}</p>{% endif %}
</div>

<div class="form-group">
  <label for="firstName">Prénom</label>
  <input type="text" id="firstName" name="firstName" value="{{ values.firstName|default('') }}" maxlength="100" required>
  {% if errors.firstName %}<p class="field-error">{{ errors.firstName }}</p>{% endif %}
</div>

<div class="form-group">
  <label for="email">Email</label>
  <input type="email" id="email" name="email" value="{{ values.email|default('') }}" autocomplete="email" required>
  {% if errors.email %}<p class="field-error">{{ errors.email }}</p>{% endif %}
</div>

<div class="form-group">
  <label for="password">
    Mot de passe
    {% if student is defined %}<span class="muted">(laisser vide pour ne pas changer)</span>{% endif %}
  </label>
  <input type="password" id="password" name="password" minlength="8" maxlength="72" autocomplete="new-password" {% if student is not defined %}required{% endif %}>
  {% if errors.password %}<p class="field-error">{{ errors.password }}</p>{% endif %}
</div>

<div class="form-group">
  <label for="phone">Téléphone <span class="muted">(optionnel)</span></label>
  <input type="tel" id="phone" name="phone" value="{{ values.phone|default('') }}" maxlength="20" autocomplete="tel">
  {% if errors.phone %}<p class="field-error">{{ errors.phone }}</p>{% endif %}
</div>
