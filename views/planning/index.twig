{% extends 'layouts/base.twig' %}

{% block content %}
  <section class="page-header planning-header">
    <div class="planning-toolbar">
      <h1>Planning</h1>
      {% if employees|length > 0 %}
        <form method="get" action="/planning" class="agenda-employee-picker">
          <label for="employeeId">Employé</label>
          <select id="employeeId" name="employeeId" onchange="this.form.submit()">
            {% for emp in employees %}
              <option value="{{ emp.id }}" {% if selected and selected.id == emp.id %}selected{% endif %}>
                {{ emp.lastName }} {{ emp.firstName }}
              </option>
            {% endfor %}
          </select>
          <noscript><button type="submit" class="btn btn-small">Afficher</button></noscript>
        </form>
      {% endif %}
    </div>
    {% if selected %}
      <a href="/planning/new?employeeId={{ selected.id }}" class="btn btn-primary">+ Nouveau creneau</a>
    {% endif %}
  </section>

  {% if employees|length > 0 and selected %}
    <p class="muted planning-hint">Glissez un créneau pour le déplacer, étirez-le pour changer sa durée, ou sélectionnez une plage vide pour en créer un.</p>
    <div id="calendar"
         data-events-url="/planning/events?employeeId={{ selected.id }}"
         data-editable="true"
         data-create-base="/planning/new?employeeId={{ selected.id }}"
         data-move-url="/planning/__ID__/move"
         data-csrf="{{ csrfToken }}"></div>
  {% else %}
    <p class="muted">Aucun employé. <a href="/employees/new">Créez un employé</a> pour commencer à planifier.</p>
  {% endif %}
{% endblock %}

{% block scripts %}
  <script src="/vendor/fullcalendar/index.global.min.js"></script>
  <script src="/vendor/fullcalendar/fr.global.min.js"></script>
  <script src="/js/planning-calendar.js"></script>
{% endblock %}
