{% extends 'layouts/base.twig' %}

{% block content %}
  <section class="page-header">
    <h1>Ordinateurs</h1>
    <a href="/computers/new" class="btn btn-primary">+ Nouvel ordinateur</a>
  </section>

  {% if computers|length > 0 %}
    <table class="data-table">
      <thead>
        <tr>
          <th>Adresse MAC</th>
          <th>Statut</th>
          <th>Employé affecté</th>
          <th>Affectation</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for c in computers %}
          <tr>
            <td>{{ c.macAddress }}</td>
            <td>
              {% if c.employee %}
                <span class="badge badge-assigned">Affecté</span>
              {% else %}
                <span class="badge badge-available">Disponible</span>
              {% endif %}
            </td>
            <td>
              {% if c.employee %}{{ c.employee.lastName }} {{ c.employee.firstName }}{% else %}—{% endif %}
            </td>
            <td>
              {% if c.employee %}
                <form action="/computers/{{ c.id }}/unassign" method="post" class="inline-form">
                  <button type="submit" class="btn btn-small">Désaffecter</button>
                </form>
              {% elseif assignableEmployees|length > 0 %}
                <form action="/computers/{{ c.id }}/assign" method="post" class="assign-form">
                  <select name="employeeId" required>
                    <option value="">Choisir un employé…</option>
                    {% for e in assignableEmployees %}
                      <option value="{{ e.id }}">{{ e.lastName }} {{ e.firstName }}</option>
                    {% endfor %}
                  </select>
                  <button type="submit" class="btn btn-small btn-primary">Affecter</button>
                </form>
              {% else %}
                <span class="muted">Aucun employé disponible</span>
              {% endif %}
            </td>
            <td class="actions">
              <a href="/computers/{{ c.id }}/edit" class="btn btn-small">Modifier</a>
              <form action="/computers/{{ c.id }}/delete" method="post" class="inline-form"
                    onsubmit="return confirm('Supprimer cet ordinateur ?');">
                <button type="submit" class="btn btn-small btn-danger">Supprimer</button>
              </form>
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  {% else %}
    <p class="muted">Aucun ordinateur pour le moment.</p>
  {% endif %}
{% endblock %}
