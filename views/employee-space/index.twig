{% extends 'layouts/base.twig' %}

{% block content %}
  <section class="page-header">
    <h1>Mon espace</h1>
  </section>

  <section class="summary-grid">
    <article class="summary-card">
      <h2>Profil</h2>
      <p><strong>{{ employee.firstName }} {{ employee.lastName }}</strong></p>
      <p class="muted">{{ employee.email }}</p>
      <p class="muted">{{ employee.company.businessName }}</p>
    </article>

    <article class="summary-card">
      <h2>Véhicule affecté</h2>
      {% if employee.vehicle %}
        <p><strong>{{ employee.vehicle.registrationNumber }}</strong></p>
        <p class="muted">{{ employee.vehicle.brand }} {{ employee.vehicle.model }}</p>
      {% else %}
        <p class="muted">Aucun véhicule affecté pour le moment.</p>
      {% endif %}
    </article>
  </section>

  <section class="page-header">
    <h2>Mon planning</h2>
  </section>

  <div id="calendar"
       data-events-url="/employee-space/events"
       data-editable="false"></div>
{% endblock %}

{% block scripts %}
  {# FullCalendar est charge paresseusement par planning-calendar.js (a l'approche
     du calendrier), pour ne pas executer ~282 Ko de JS au chargement initial. #}
  <script src="/js/planning-calendar.js" defer></script>
{% endblock %}
