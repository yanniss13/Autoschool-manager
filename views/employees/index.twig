{% extends 'layouts/base.twig' %}

{% block content %}
  <section class="page-header">
    <h1>Employés</h1>
    <a href="/employees/new" class="btn btn-primary">+ Nouvel employé</a>
  </section>

  {% if employees|length > 0 %}
    <table class="data-table">
      <thead>
        <tr>
          <th>Nom</th>
          <th>Prénom</th>
          <th>Email</th>
          <th>Âge</th>
          <th>Genre</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for e in employees %}
          <tr>
            <td>{{ e.lastName }}</td>
            <td>{{ e.firstName }}</td>
            <td>{{ e.email }}</td>
            <td>{{ e.age|default('—') }}</td>
            <td>{{ e.gender|default('—')|capitalize }}</td>
            <td class="actions">
              <a href="/employees/{{ e.id }}/edit" class="btn btn-small">Modifier</a>
              <form action="/employees/{{ e.id }}/delete" method="post" class="inline-form"
                    data-confirm="Supprimer cet employé ?">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                <button type="submit" class="btn btn-small btn-danger">Supprimer</button>
              </form>
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  {% else %}
    <p class="muted">Aucun employé pour le moment.</p>
  {% endif %}
{% endblock %}
