{% extends 'layouts/base.twig' %}

{% block content %}
  <section class="form-card">
    <h1>Mot de passe oublié</h1>

    {% if notice %}<div class="flash flash-success">{{ notice }}</div>{% endif %}
    {% if errors.global %}<div class="flash flash-error">{{ errors.global }}</div>{% endif %}

    <p class="form-footer">
      Saisissez l'email de votre compte élève : nous vous enverrons un lien pour
      choisir un nouveau mot de passe.
    </p>

    <form action="/forgot-password" method="post" novalidate>
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <div class="form-group">
        <label for="email">Email élève</label>
        <input type="email" id="email" name="email"
               autocomplete="username" value="{{ values.email|default('') }}" required>
        {% if errors.email %}<p class="field-error">{{ errors.email }}</p>{% endif %}
      </div>

      <button type="submit" class="btn btn-primary">Envoyer le lien</button>
    </form>

    <p class="form-footer"><a href="/student-login">Retour à la connexion</a></p>
  </section>
{% endblock %}
