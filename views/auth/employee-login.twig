{% extends 'layouts/base.twig' %}

{% block content %}
  <section class="form-card">
    <h1>Connexion employe</h1>

    {% if errors.global %}<div class="flash flash-error">{{ errors.global }}</div>{% endif %}

    <form action="/employee-login" method="post" novalidate>
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <div class="form-group">
        <label for="email">Email professionnel</label>
        <input type="email" id="email" name="email"
               autocomplete="username" value="{{ values.email|default('') }}" required>
        {% if errors.email %}<p class="field-error">{{ errors.email }}</p>{% endif %}
      </div>

      <div class="form-group">
        <label for="password">Mot de passe</label>
        <input type="password" id="password" name="password"
               autocomplete="current-password" required>
        {% if errors.password %}<p class="field-error">{{ errors.password }}</p>{% endif %}
      </div>

      <button type="submit" class="btn btn-primary">Se connecter</button>
    </form>

    <p class="form-footer">Espace reserve aux employes deja crees par le gerant.</p>
  </section>
{% endblock %}
