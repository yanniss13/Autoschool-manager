{% extends 'layouts/base.twig' %}

{% block content %}
  <section class="form-card">
    <h1>Inscription de l'auto-école</h1>

    {% if errors.global %}<div class="flash flash-error" role="alert">{{ errors.global }}</div>{% endif %}

    <form action="/register" method="post" novalidate>
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <div class="form-group">
        <label for="businessName">Raison sociale</label>
        <input type="text" id="businessName" name="businessName"
               autocomplete="organization" value="{{ values.businessName|default('') }}" required>
        {% if errors.businessName %}<p class="field-error">{{ errors.businessName }}</p>{% endif %}
      </div>

      <div class="form-group">
        <label for="siret">SIRET</label>
        <input type="text" id="siret" name="siret" inputmode="numeric"
               autocomplete="username" value="{{ values.siret|default('') }}" required>
        {% if errors.siret %}<p class="field-error">{{ errors.siret }}</p>{% endif %}
      </div>

      <div class="form-group">
        <label for="directorName">Nom du directeur <span class="muted">(optionnel)</span></label>
        <input type="text" id="directorName" name="directorName"
               autocomplete="name" value="{{ values.directorName|default('') }}">
        {% if errors.directorName %}<p class="field-error">{{ errors.directorName }}</p>{% endif %}
      </div>

      <div class="form-group">
        <label for="password">Mot de passe</label>
        <input type="password" id="password" name="password"
               autocomplete="new-password" required>
        {% if errors.password %}<p class="field-error">{{ errors.password }}</p>{% endif %}
      </div>

      <div class="form-group">
        <label for="passwordConfirm">Confirmation du mot de passe</label>
        <input type="password" id="passwordConfirm" name="passwordConfirm"
               autocomplete="new-password" required>
        {% if errors.passwordConfirm %}<p class="field-error">{{ errors.passwordConfirm }}</p>{% endif %}
      </div>

      <button type="submit" class="btn btn-primary">Créer le compte</button>
    </form>

    <p class="form-footer">Déjà inscrit ? <a href="/login">Se connecter</a></p>
  </section>
{% endblock %}
