{% extends 'layouts/base.twig' %}

{% block content %}
  <section class="page-header">
    <h1>Véhicules</h1>
    <a href="/vehicles/new" class="btn btn-primary">+ Nouveau véhicule</a>
  </section>

  {% if vehicles|length > 0 %}
    <table class="data-table">
      <thead>
        <tr>
          <th>Immatriculation</th>
          <th>Marque</th>
          <th>Modèle</th>
          <th>Année</th>
          <th>Boîte</th>
          <th>Statut</th>
          <th>Employé affecté</th>
          <th>Affectation</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for v in vehicles %}
          <tr>
            <td>{{ v.registrationNumber }}</td>
            <td>{{ v.brand }}</td>
            <td>{{ v.model }}</td>
            <td>{{ v.year|default('—') }}</td>
            <td>
              {% if v.transmission == 'manual' %}Manuelle
              {% elseif v.transmission == 'automatic' %}Automatique
              {% else %}—{% endif %}
            </td>
            <td>
              {% if v.employee %}
                <span class="badge badge-assigned">Affecté</span>
              {% else %}
                <span class="badge badge-available">Disponible</span>
              {% endif %}
            </td>
            <td>
              {% if v.employee %}{{ v.employee.lastName }} {{ v.employee.firstName }}{% else %}—{% endif %}
            </td>
            <td>
              {% if v.employee %}
                <form action="/vehicles/{{ v.id }}/unassign" method="post" class="inline-form">
                  <button type="submit" class="btn btn-small">Désaffecter</button>
                </form>
              {% elseif assignableEmployees|length > 0 %}
                <form action="/vehicles/{{ v.id }}/assign" method="post" class="assign-form">
                  <select name="employeeId" required>
                    <option value="">Choisir un employé…</option>
                    {% for e in assignableEmployees %}
                      <option value="{{ e.id }}">{{ e.lastName }} {{ e.firstName }}</option>
                    {% endfor %}
                  </select>
                  <button type="submit" class="btn btn-small btn-primary">Affecter</button>
                </form>
              {% else %}
                <span class="muted">Aucun employé disponible</span>
              {% endif %}
            </td>
            <td class="actions">
              <a href="/vehicles/{{ v.id }}/edit" class="btn btn-small">Modifier</a>
              <form action="/vehicles/{{ v.id }}/delete" method="post" class="inline-form"
                    onsubmit="return confirm('Supprimer ce véhicule ?');">
                <button type="submit" class="btn btn-small btn-danger">Supprimer</button>
              </form>
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  {% else %}
    <p class="muted">Aucun véhicule pour le moment.</p>
  {% endif %}
{% endblock %}
