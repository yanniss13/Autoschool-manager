{% extends 'layouts/base.twig' %}

{% block content %}
  <section class="hero">
    <h1>Tableau de bord</h1>
    <p>Bienvenue, <strong>{{ currentCompany.businessName }}</strong>.</p>

    <ul class="info-list">
      <li><span class="info-label">Raison sociale :</span> {{ currentCompany.businessName }}</li>
      <li><span class="info-label">SIRET :</span> {{ currentCompany.siret }}</li>
      {% if currentCompany.directorName %}
        <li><span class="info-label">Directeur :</span> {{ currentCompany.directorName }}</li>
      {% endif %}
    </ul>
  </section>

  <section class="stats-grid">
    <div class="stat-card">
      <span class="stat-value">{{ stats.employees }}</span>
      <span class="stat-label">Employés</span>
    </div>
    <div class="stat-card">
      <span class="stat-value">{{ stats.computers }}</span>
      <span class="stat-label">Ordinateurs</span>
    </div>
    <div class="stat-card">
      <span class="stat-value">{{ stats.assigned }}</span>
      <span class="stat-label">Postes affectés</span>
    </div>
    <div class="stat-card">
      <span class="stat-value">{{ stats.available }}</span>
      <span class="stat-label">Postes disponibles</span>
    </div>
  </section>

  <div class="dashboard-actions">
    <a href="/employees" class="btn btn-primary">Gérer les employés</a>
    <a href="/computers" class="btn btn-primary">Gérer les ordinateurs</a>
  </div>
{% endblock %}
