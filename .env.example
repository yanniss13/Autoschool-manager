# Base de donnees SQLite (fichier local, relatif au dossier prisma/schema/)
DATABASE_URL="file:../dev.db"

# Secret de session (remplacer par une longue chaine aleatoire)
SESSION_SECRET="change-me-with-a-long-random-string"

# Port du serveur HTTP
PORT=3000

# Environnement : "production" active les cookies secure (HTTPS) et trust proxy.
# Laisser "development" en local (HTTP).
NODE_ENV=development
