# Base de donnees SQLite (fichier local, relatif au dossier prisma/schema/)
DATABASE_URL="file:../dev.db"

# Secret de session (remplacer par une longue chaine aleatoire)
SESSION_SECRET="change-me-with-a-long-random-string"

# Port du serveur HTTP
PORT=3000

# Environnement : "production" active les cookies secure (HTTPS) et trust proxy.
# Laisser "development" en local (HTTP).
NODE_ENV=development

# Cle API Groq (gratuite) pour l'assistant code de la route.
# Laisser vide pour utiliser le repli local hors-ligne (mots-cles).
# Obtenir une cle sur https://console.groq.com/keys
GROQ_API_KEY=
# Modele Groq (optionnel ; defaut : llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile
