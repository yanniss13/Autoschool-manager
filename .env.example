# Base de donnees SQLite (fichier local, relatif au dossier prisma/schema/)
DATABASE_URL="file:../dev.db"

# Secret de session (remplacer par une longue chaine aleatoire)
SESSION_SECRET="change-me-with-a-long-random-string"

# Port du serveur HTTP
PORT=3000

# Environnement : "production" active les cookies secure (HTTPS) et trust proxy.
# Laisser "development" en local (HTTP).
NODE_ENV=development

# Cle API Groq (gratuite) pour l'assistant code de la route.
# Laisser vide pour utiliser le repli local hors-ligne (mots-cles).
# Obtenir une cle sur https://console.groq.com/keys
GROQ_API_KEY=
# Modele Groq (optionnel ; defaut : llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# Envoi d'emails (SMTP). Laisser vide desactive l'envoi (les actions ne plantent pas).
# Pour tester sans delivrer de vrais emails : creer une inbox sur https://mailtrap.io
# (Email Testing) et recopier l'hote/port/identifiants du bac a sable.
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
# Expediteur affiche dans les emails.
MAIL_FROM="AutoSchool Manager <no-reply@autoschool.local>"
# URL de base utilisee pour construire les liens (ex. reinitialisation de mot de passe).
APP_URL=http://localhost:3000
